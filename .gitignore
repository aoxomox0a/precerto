.python-version
# Note: Professional teams usually COMMIT uv.lock to ensure reproducibility.
# Do NOT add uv.lock here unless you are strictly prototyping solo.

# --- Environment & Secrets ---
.env
.env.*
!.env.example
secrets.json

# --- Inference Models (Whisper / CTranslate2) ---
# Large model weights should stay local or in specialized storage (LFS)
models/
*.bin
*.model
*.gz
*.pt
*.onnx

# --- Data & Reasoning Layer (Neo4j / SNOMED) ---
# Do not commit raw database files or large CSV datasets
neo4j/data/
neo4j/logs/
neo4j/import/
*.csv
*.json
!package.json
!package-lock.json

# --- Logs & Performance ---
*.log
perf.data
perf.data.old

